{
  "name": "crisp-plugin-mcp",
  "version": "0.1.0",
  "description": "MCP server with the same tools as Crisp's official MCP server, authenticated with a Crisp Marketplace plugin token.",
  "keywords": [
    "crisp",
    "crisp-chat",
    "customer-support",
    "helpdesk",
    "mcp",
    "model-context-protocol"
  ],
  "homepage": "https://github.com/amitray007/crisp-plugin-mcp#readme",
  "bugs": {
    "url": "https://github.com/amitray007/crisp-plugin-mcp/issues"
  },
  "license": "MIT",
  "author": "Amit Ray (https://github.com/amitray007)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amitray007/crisp-plugin-mcp.git"
  },
  "bin": {
    "crisp-plugin-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm knip",
    "sync-tools": "tsx scripts/sync-tools.ts",
    "smoke": "node scripts/smoke.ts",
    "smoke:live": "tsx scripts/smoke-live.ts",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "crisp-api": "^12.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "26.6.6",
    "knip": "6.46.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.14.0"
}
